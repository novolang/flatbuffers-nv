pub fn read_i64(b: FbBuf, at: Int) -> Result<Int, FbFault> []
    todo("flatbuffers-nv.fbbuf.read_i64")

// A little-endian `f64` at an offset, checked for bounds and
// alignment.
//
// ```novo
// use std.bytes
// use fbbuf
//
// fn main() [io]
//     match fbbuf.read_f64(fbbuf.buffer(bytes.zeros(8)), 0)
//         Ok(v)  => println("${v}")
//         Err(e) => println(e.message())
// ```
pub fn read_f64(b: FbBuf, at: Int) -> Result<Float, FbFault> []
    todo("flatbuffers-nv.fbbuf.read_f64")

// Follow a uoffset at `at`: `at + read_u32(at)`.
//
// The one piece of arithmetic every reference in the format is.  A
// uoffset is relative to ITS OWN POSITION and always forward, which is
// what lets a subtree be written once and referenced from several
// places.
//
// ```novo
// use std.bytes
// use fbbuf
//
// fn main() [io]
//     match fbbuf.follow(fbbuf.buffer(bytes.zeros(8)), 0)
//         Ok(p)  => println("${p}")
//         Err(e) => println(e.message())
// ```
pub fn follow(b: FbBuf, at: Int) -> Result<Int, FbFault> []
    todo("flatbuffers-nv.fbbuf.follow")

// Whether `at` is aligned to `align` bytes.
//
// ```novo
// use fbbuf
//
// fn main() [io]
//     println("${fbbuf.is_aligned(8, 4)}")
// ```
pub fn is_aligned(at: Int, align: Int) -> Bool []
    todo("flatbuffers-nv.fbbuf.is_aligned")

// `n` rounded up to the next multiple of `align`.
//
// `FbBadParameter` when `align` is not a power of two.
//
// ```novo
// use fbbuf
//
// fn main() [io]
//     match fbbuf.align_up(5, 4)
//         Ok(n)  => println("${n}")
//         Err(e) => println(e.message())
// ```
pub fn align_up(n: Int, align: Int) -> Result<Int, FbFault> []
    todo("flatbuffers-nv.fbbuf.align_up")

// Whether an offset is inside the buffer, with `n` bytes of room.
//
// The bounds check every accessor makes, published so that a caller
// walking a buffer with the unchecked accessors can make it once for a
// region rather than once per field.
//
// ```novo
// use std.bytes
// use fbbuf
//
// fn main() [io]
//     println("${fbbuf.in_bounds(fbbuf.buffer(bytes.zeros(8)), 0, 4)}")
// ```
pub fn in_bounds(b: FbBuf, at: Int, n: Int) -> Bool []
    todo("flatbuffers-nv.fbbuf.in_bounds")
