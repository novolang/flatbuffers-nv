// Element `i` of a vector of tables.
//
// The elements are uoffsets, so this follows one.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 4)
//         Ok(v) =>
//             match fbvector.get_table(v, 0)
//                 Ok(_)  => println("a table")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn get_table(v: FbVector, i: Int) -> Result<FbTable, FbFault> []
    todo("flatbuffers-nv.fbvector.get_table")

// Where element `i` of a vector of STRUCTS sits.
//
// Structs are stored inline in the vector, so this is a position and
// not a follow — which is why a vector of a million three-float
// vertices is twelve megabytes and one allocation and not a million
// offsets.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 12)
//         Ok(v)  => println("${fbvector.get_struct_at(v, 0)}")
//         Err(e) => println(e.message())
// ```
pub fn get_struct_at(v: FbVector, i: Int) -> Int []
    todo("flatbuffers-nv.fbvector.get_struct_at")

// A string in a buffer: its bytes, without the terminator.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.string_at(fbbuf.buffer(bytes.zeros(16)), 8)
//         Ok(s)  => println("${bytes.len(s)}")
//         Err(e) => println(e.message())
// ```
pub fn string_at(b: FbBuf, at: Int) -> Result<Bytes, FbFault> []
    todo("flatbuffers-nv.fbvector.string_at")

// A table's string field, as bytes, or `None` when absent.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbtable
// use fbvector
//
// fn main() [io]
//     match fbtable.table_at(fbbuf.buffer(bytes.zeros(16)), 8)
//         Ok(t) =>
//             match fbvector.field_string(t, fbtable.FB_FIRST_SLOT)
//                 Ok(_)  => println("read")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn field_string(t: FbTable, slot: Int) -> Result<?Bytes, FbFault> []
    todo("flatbuffers-nv.fbvector.field_string")

// A string, checked for UTF-8.
//
// `FbStringNotUtf8` when the bytes are not.  A SEPARATE function from
// `string_at` because the format says a string is UTF-8 and does not
// say a reader must verify: checking per access would cost this format
// the thing it exists for, and a caller that cares checks once.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.utf8_string(fbbuf.buffer(bytes.zeros(16)), 8)
//         Ok(s)  => println(s)
//         Err(e) => println(e.message())
// ```
pub fn utf8_string(b: FbBuf, at: Int) -> Result<Str, FbFault> []
    todo("flatbuffers-nv.fbvector.utf8_string")

// Whether the zero byte the format requires after a string's bytes is
// there.
//
// Not counted in the length, and there so that a C consumer can point
// at the bytes.  `fbverify` checks it; this is the check on its own,
// for a caller reading one string out of an unverified buffer.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     println("${fbvector.string_is_terminated(fbbuf.buffer(bytes.zeros(16)), 8)}")
// ```
pub fn string_is_terminated(b: FbBuf, at: Int) -> Bool []
    todo("flatbuffers-nv.fbvector.string_is_terminated")

// How many bytes a struct of these members occupies, and how it is
// aligned.
//
// A struct's size is its members laid out in order, each aligned to
// its own size, and the whole padded to a multiple of the LARGEST
// member's alignment.  Published because that padding is invisible in
// a schema and is exactly what a hand-written reader gets wrong: a
// `struct Vec3 { x:float; y:float; z:float; }` is twelve bytes, and a
// `struct Mixed { a:byte; b:double; }` is SIXTEEN.
//
// ```novo
// use fbvector
//
// fn main() [io]
//     match fbvector.struct_layout([4, 4, 4])
//         Ok(l)  => println("${l.size} ${l.align}")
//         Err(e) => println(e.message())
// ```
pub struct FbStructLayout
    // The struct's total size, padded.
    size: Int
    // The struct's alignment: the largest member's.
    align: Int

// The layout a list of member sizes produces.
//
// `FbBadParameter` for a member size that is not a power of two, which
// no FlatBuffers scalar is.
//
// ```novo
// use fbvector
//
// fn main() [io]
//     match fbvector.struct_layout([1, 8])
//         Ok(l)  => println("${l.size}")
//         Err(e) => println(e.message())
// ```
pub fn struct_layout(member_sizes: [Int]) -> Result<FbStructLayout, FbFault> []
    todo("flatbuffers-nv.fbvector.struct_layout")

// Where member `i` of a struct sits, relative to the struct's start.
//
// The padding made explicit, so a reader never counts member sizes by
// hand.
//
// ```novo
// use fbvector
//
// fn main() [io]
//     match fbvector.struct_member_at([1, 8], 1)
//         Ok(n)  => println("${n}")
//         Err(e) => println(e.message())
// ```
pub fn struct_member_at(member_sizes: [Int], i: Int) -> Result<Int, FbFault> []
    todo("flatbuffers-nv.fbvector.struct_member_at")
