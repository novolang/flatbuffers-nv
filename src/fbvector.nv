// fbvector.nv — vectors, strings and structs: the three things a table
// points AT rather than contains, plus the one it contains inline.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// A VECTOR IS A LENGTH AND THEN ITS ELEMENTS.  A `u32` count, then
// `count` elements of the element's own size, each aligned.  A table's
// vector field holds a uoffset to the LENGTH, so the elements start
// four bytes after it.
//
// ELEMENT ACCESS IS ARITHMETIC AND NOTHING ELSE.  `elements_at + i *
// size`.  A vector of a million integers costs one bounds check and a
// multiply to read the last one, and nothing at all to skip — which is
// the whole reason to choose this format over one that parses.
//
// A STRING IS A VECTOR OF BYTES WITH A ZERO AFTER IT.  The terminator
// is NOT counted in the length; it is there so that a C consumer can
// point at the bytes and call `strlen`.  A writer that omitted it
// produces a buffer that other readers walk off the end of, and
// `fbverify` checks for it.
//
// AND A STRING IS NOT CHECKED FOR UTF-8 BY THE ORDINARY ACCESSOR.  The
// format says a string is UTF-8; it does not say a reader must verify,
// and verifying per access would cost the format its reason for
// existing.  `utf8_string` is the checking one, and a caller that
// cares calls it once rather than paying for it always.
//
// A STRUCT IS INLINE AND THAT IS ITS WHOLE CHARACTER.  Fixed size, no
// vtable, no optional fields, no strings, no vectors — only scalars and
// other structs, aligned to the largest member and padded to a multiple
// of it.  It costs nothing to read and it CAN NEVER GROW: its size is
// baked into every table that contains it and into every vector of it,
// so adding a field to a struct invalidates every buffer ever written.
// A table is the thing that evolves; a struct is the thing that does
// not.

use fberror
use fbbuf
use fbtable

// The bytes a vector's length prefix occupies: 4.
pub const FB_VECTOR_LENGTH_BYTES = 4

// A vector in a buffer.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 4)
//         Ok(v)  => println("${v.length}")
//         Err(e) => println(e.message())
// ```
pub struct FbVector
    // The buffer.
    buf: FbBuf
    // Where the elements start: four bytes after the length.
    elements_at: Int
    // How many elements there are.
    length: Int
    // How many bytes one element occupies.  Four for a vector of
    // tables, strings or other vectors, because those are uoffsets;
    // the struct's own size for a vector of structs.
    elem_size: Int

// The vector at a position, given its element size.
//
// `at` is where the LENGTH is, which is where a table's vector field
// points.  `FbBadVectorLength`, which `fberror.is_malformed` calls
// damage, when the length would put the last element outside the
// buffer — the check a reader cannot skip, because
// a length is four bytes of somebody else's file and four billion is
// representable in them.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 4)
//         Ok(v)  => println("${v.elem_size}")
//         Err(e) => println(e.message())
// ```
pub fn vector_at(b: FbBuf, at: Int, elem_size: Int) -> Result<FbVector, FbFault> []
    todo("flatbuffers-nv.fbvector.vector_at")

// A table's vector field, or `None` when absent.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbtable
// use fbvector
//
// fn main() [io]
//     match fbtable.table_at(fbbuf.buffer(bytes.zeros(16)), 8)
//         Ok(t) =>
//             match fbvector.field_vector(t, fbtable.FB_FIRST_SLOT, 4)
//                 Ok(_)  => println("read")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn field_vector(t: FbTable, slot: Int, elem_size: Int) -> Result<?FbVector, FbFault> []
    todo("flatbuffers-nv.fbvector.field_vector")

// Where element `i` sits: `elements_at + i * elem_size`.
//
// `-1` for an index outside the vector.  THE WHOLE COST OF RANDOM
// ACCESS: a multiply and an add, for element zero or element nine
// hundred thousand alike.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 4)
//         Ok(v)  => println("${fbvector.element_at(v, 0)}")
//         Err(e) => println(e.message())
// ```
pub fn element_at(v: FbVector, i: Int) -> Int []
    todo("flatbuffers-nv.fbvector.element_at")

// Element `i` of a vector of 8-bit values.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 1)
//         Ok(v) =>
//             match fbvector.get_u8(v, 0)
//                 Ok(x)  => println("${x}")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn get_u8(v: FbVector, i: Int) -> Result<Int, FbFault> []
    todo("flatbuffers-nv.fbvector.get_u8")

