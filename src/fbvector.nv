// Element `i` of a vector of `double`.
//
// ```novo
// use std.bytes
// use fbbuf
// use fbvector
//
// fn main() [io]
//     match fbvector.vector_at(fbbuf.buffer(bytes.zeros(16)), 8, 8)
//         Ok(v) =>
//             match fbvector.get_f64(v, 0)
//                 Ok(x)  => println("${x}")
